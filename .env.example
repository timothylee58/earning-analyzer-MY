# Hugging Face Inference API token (https://huggingface.co/settings/tokens)
# Without a token the NLP pipeline falls back to the offline lexicon scorer.
HF_API_TOKEN=

# Override the default model endpoints if needed
FINBERT_MODEL=ProsusAI/finbert
XLMR_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
